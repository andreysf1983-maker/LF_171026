     @{ Db = "world";      File = "07_legion_instance_template.sql" },
@@ -62,7 +71,12 @@ $patches = @(
     # но playercreateinfo/player_levelstats/race_unlock_requirement оставались
     # пустыми (CHAR_CREATE_FAILED). 52_primary применяется после 48/49 и
