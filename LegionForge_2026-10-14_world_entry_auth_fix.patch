+-- =====================================================================
+-- LEGIONFORGE 7.3.5.26124 - [102] Final DBErrors.log cleanup (orphan loot)
+-- Target: WORLD database. Idempotent (DELETE-only, safe to re-run).
+--
+-- Complements 100_* and 101_*: removes the remaining "useless / orphan"
+-- loot rows that TrinityCore's DB checker prints into DBErrors.log on
+-- every world boot. These rows reference spell/reference ids that do not
+-- exist in the 7.3.5.26124 client DB2 (BFA / custom content), so they can
+-- never produce loot and only generate noise.
+--
+-- Categories taken verbatim from DBErrors.log:
+--   * spell_loot_template entries that "isn't spell id (random item
+--     creating) and not referenced from loot, and thus useless".
+--   * reference_loot_template entries that "isn't reference id and not
+--     referenced from loot, and thus useless".
+-- =====================================================================
+
+-- [102-1] spell_loot_template: Entry isn't a spell id and not referenced.
+DELETE FROM `spell_loot_template`
+ WHERE `entry` IN (263148, 263149, 263150, 263151, 263152, 263153, 263154);
+
+-- [102-2] reference_loot_template: Entry isn't a reference id and not referenced.
+DELETE FROM `reference_loot_template`
+ WHERE `entry` IN (210020, 210021, 210022, 210023, 210024, 210025, 210026, 210027, 210028, 210029);
+
+-- [102-3] Belt-and-braces: spell_loot_template rows for BFA 253xxx-255xxx
+-- spells that are absent from the 26124 client (subset of 100_*, kept here
+-- so 102 alone is a complete final pass). DELETE-only and bounded -> safe.
+DELETE FROM `spell_loot_template`
+ WHERE `entry` IN (253113, 253116, 253117, 253118, 253125, 253132, 253135, 253138,
+                   253141, 253144, 253149, 253156, 253157, 253158, 253159, 253160,
+                   253161, 253162, 253165, 253168, 253171, 253174, 253177, 253180,
+                   253183, 253186, 253187, 253188, 253190, 253191, 253192, 255457,
+                   255458, 255459, 255610);
+
+-- =====================================================================
+-- NOTE on the remaining DBErrors.log lines (intentionally NOT touched):
+--   * "areatrigger ... wrong spawn mask ... unsupported difficulty modes":
+--     cosmetic sql.sql warning; the core already indexes spawnMasks by map
+--     id (see AreaTriggerDataStore.cpp). Changing live spawn masks could
+--     break difficulty-specific triggers, so we leave the data intact.
+--   * "79 dungeon(s) have no entrance" and BFA/test dungeons present in DB2
+--     but absent from the 26124 client: skipped by LFG, harmless.
+--   * npc_spellclick_spells / spell_linked_spell notices: auto-handled by
+--     the core loader.
+-- =====================================================================
